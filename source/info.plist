				<key>script</key>
				<string>#!/bin/bash

# RhymeZone — fetch rhymes from the Datamuse API and emit Alfred JSON.
# jq builds the JSON so returned words are always correctly escaped.

word="$1"

if [[ -z "$word" ]]; then
    jq -n '{items: [{title: "Type a word to find rhymes", valid: false}]}'
    exit 0
fi

response=$(curl -s -G "https://api.datamuse.com/words" --data-urlencode "rel_rhy=$word")

if [[ -z "$response" || "$response" == "[]" ]]; then
    jq -n --arg w "$word" '{items: [{title: "No rhymes found", subtitle: $w, valid: false}]}'
    exit 0
fi

echo "$response" | jq '{items: [ .[] | {
    title: .word,
    subtitle: ("syllables: \(.numSyllables // "?"), score: \(.score // "?")"),
    valid: true,
    arg: .word
} ]}'
</string>
