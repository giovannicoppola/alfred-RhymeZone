				<key>script</key>
				<string>#!/bin/bash

# Function to fetch rhymes using Datamuse API and format as JSON
get_rhymes() {
    local word="$1"
    local url="https://api.datamuse.com/words?rel_rhy=${word}"

    # Fetch data using curl and parse JSON output using jq
    response=$(curl -s "$url")

    # Check if response is empty or contains no rhymes
    if [[ -z "$response" || "$response" == "[]" ]]; then
        echo '{"items": []}'
        exit 1
    fi

    # Start JSON output
    echo '{"items": ['

    # Use jq to process each item in the response
    first=true
    # Loop over the JSON array using jq
    echo "$response" | jq -c '.[]' | while read -r row; do
        title=$(echo "$row" | jq -r '.word')
        score=$(echo "$row" | jq -r '.score')
        syllables=$(echo "$row" | jq -r '.numSyllables')

        # Add a comma for all but the first item
        if [ "$first" = true ]; then
            first=false
        else
            echo ","
        fi

        # Print the individual JSON item with syllables in subtitle
        echo -n "  {"
        echo -n "\"title\": \"$title\","
        echo -n "\"subtitle\": \"syllables: $syllables, score: $score\","
        echo -n "\"valid\": true,"

        echo -n "\"arg\": \"$title\""
        echo "}"
    done

    # End JSON output
    echo ']}'
}

# Check if a word is provided
if [[ -z "$1" ]]; then
    echo "Usage: $0 &lt;word&gt;"
    exit 1
fi

get_rhymes "$1"
